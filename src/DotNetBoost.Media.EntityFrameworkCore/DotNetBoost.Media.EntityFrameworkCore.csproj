<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>DotNetBoost.Media.EntityFrameworkCore</PackageId>
    <Description>
      Entity Framework Core metadata store for DotNetBoost.Media. One table records every upload,
      mapped into your own DbContext — so a file and the entity it belongs to can be saved in one
      transaction — with indexes for the queries the library actually issues. Supports SQL Server,
      PostgreSQL and SQLite.
    </Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DotNetBoost.Media.ProviderTests" />
    <InternalsVisibleTo Include="DotNetBoost.Media.IntegrationTests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../DotNetBoost.Media.Core/DotNetBoost.Media.Core.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>
</Project>
