<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>DotNetBoost.Media.Core</PackageId>
    <Description>
      Core abstractions and engine for DotNetBoost.Media — upload a file once and get back a row
      that says what it is, how big it is, what it is attached to, and where its bytes live.
      Includes IMediaManager — the one service application code injects — the metadata store
      contract (IMediaStore) and the storage backend contract (IMediaStorageProvider), plus the
      provider-neutral upload path: size limits, extension rules, content-type verification
      against the file's own bytes, SHA-256 checksums and optional deduplication.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The engine services (the manager, the validator, the registry, the streaming helpers) are
         internal: applications use IMediaManager. The sibling packages build on the engine
         directly, as the storage backends do. -->
    <InternalsVisibleTo Include="DotNetBoost.Media.EntityFrameworkCore" />
    <InternalsVisibleTo Include="DotNetBoost.Media.Dapper" />
    <InternalsVisibleTo Include="DotNetBoost.Media.MongoDb" />
    <InternalsVisibleTo Include="DotNetBoost.Media.FileSystem" />
    <InternalsVisibleTo Include="DotNetBoost.Media.AzureBlobStorage" />
    <InternalsVisibleTo Include="DotNetBoost.Media.AmazonS3" />
    <InternalsVisibleTo Include="DotNetBoost.Media.API" />
    <!-- The tests cover the engine directly rather than only through the public surface. -->
    <InternalsVisibleTo Include="DotNetBoost.Media.TestSupport" />
    <InternalsVisibleTo Include="DotNetBoost.Media.UnitTests" />
    <InternalsVisibleTo Include="DotNetBoost.Media.ProviderTests" />
    <InternalsVisibleTo Include="DotNetBoost.Media.IntegrationTests" />
    <InternalsVisibleTo Include="DotNetBoost.Media.ApiTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <!-- IHostedService only, for the startup probe of the storage backends. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
</Project>
