<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>DotNetBoost.Media.API</PackageId>
    <Description>
      ASP.NET Core integration for DotNetBoost.Media: minimal-API endpoints for uploading,
      listing, downloading (with Range and ETag support) and managing files, plus ProblemDetails
      mapping that turns the library's failures into the right status codes — 413 for an
      oversized upload, 415 for a rejected type, 502 when the storage backend is the problem.
    </Description>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../DotNetBoost.Media.Core/DotNetBoost.Media.Core.csproj" />
  </ItemGroup>
</Project>
