# Only needed when the dashboard and the API are started separately. Under the Aspire
# AppHost (aspire/DotNetBoost.Media.AppHost) every value is injected automatically,
# pointing at whichever ports Aspire allocated.

# Base address of the API the dashboard reads and writes: the media endpoints that
# MapMediaEndpoints() maps, and the sample's product endpoints. Used server-side by the
# /api/** proxy.
NUXT_MEDIA_API_URL=http://localhost:5180

# Where the sidebar's "API reference" link points.
NUXT_PUBLIC_API_REFERENCE_URL=http://localhost:5180/scalar

# The API's MediaOptions.MaxFileSizeBytes. The upload form rejects a larger file before sending
# it; the API enforces the real limit regardless.
NUXT_PUBLIC_MAX_UPLOAD_BYTES=26214400
