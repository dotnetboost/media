    <ProjectReference Include="../DotNetBoost.Media.TestSupport/DotNetBoost.Media.TestSupport.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- SQLite in a file, so both stores run against a real relational engine without a container.
         The engine-specific behaviour the other two need is covered in IntegrationTests. -->
