<Project Sdk="Microsoft.NET.Sdk">
  <!-- Shared test doubles, not a test project itself. The in-memory store runs the same contract
       suite as the real ones (see ProviderTests), so tests built on it are testing against
       something that is known to behave like a real store. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <TargetFramework />
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/DotNetBoost.Media.Core/DotNetBoost.Media.Core.csproj" />
  </ItemGroup>
</Project>
